## Remenber to set DB_CONNECTION_STRING, SESSION_SECRET, ADMIN_PASSWORD, and MEMBERSHIP_RIDDLE_CHECK_VALIDITY_SQL

# Server port
PORT=3000

# Application title
TITLE=Members Only

# Maximum field lengths
USERNAME_MAX_LENGTH=20
NAME_SURNAME_MAX_LENGTH=32
PASSWORD_MAX_LENGTH=20
TITLE_MAX_LENGTH=50
TEXT_MAX_LENGTH=2000

# Membership riddle constraints
MEMBERSHIP_RIDDLE_MAX_LENGTH=20

# Minimum field lengths
USERNAME_MIN_LENGTH=1
NAME_SURNAME_MIN_LENGTH=2
PASSWORD_MIN_LENGTH=8
TITLE_MIN_LENGTH=1
TEXT_MIN_LENGTH=1

# Validation regex patterns
USERNAME_REGEX=^(?=.*[a-z])(?!.*[_.\-]{2})[a-z0-9_.\-]+$
NAME_SURNAME_REGEX=^[\p{Script=Latin}\p{Mark}]+[\p{Script=Latin}\p{Mark}' \-]*[\p{Script=Latin}\p{Mark}]+$
PASSWORD_REGEX=^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]+$
TITLE_REGEX=^[\p{L}\p{N}\p{P}\p{S} ]+$
TEXT_REGEX=^[\p{L}\p{N}\p{P}\p{S}\s]+$
MEMBERSHIP_RIDDLE_REGEX=^[a-zA-Z]+$

# Regex flags
USERNAME_REGEX_FLAG=u
NAME_SURNAME_REGEX_FLAG=u
PASSWORD_REGEX_FLAG=u
TITLE_REGEX_FLAG=u
TEXT_REGEX_FLAG=u
MEMBERSHIP_RIDDLE_REGEX_FLAG=u

# Validation messages
USERNAME_REGEX_MSG=Only lowercase letters, digits, dashes (-), periods (.) and underscores (_) are allowed. Must have at least a letter and no consecutive special characters. Length: 1-20 characters.
NAME_SURNAME_REGEX_MSG=Only letters, dashes (-), apostrophes ('), and whitespaces are allowed. Must start and end with a letter. Length: 2-32 characters.
PASSWORD_REGEX_MSG=Must have at least one lowercase letter, one uppercase letter, one digit, and one special character (@$!%*?&). Length: 8-20 characters.
TITLE_REGEX_MSG=Only letters, numbers, punctuation marks, symbols, and whitespaces are allowed. Length: 1-50 characters.
TEXT_REGEX_MSG=Only letters, numbers, punctuation marks, symbols, and whitespace characters are allowed. Length: 1-2000 characters.
MEMBERSHIP_RIDDLE_REGEX_MSG=Only letters are allowed (without spaces). Length: 1-20 characters.

# PostgreSQL connection string
DB_CONNECTION_STRING=postgresql://your_user:your_password@host:port/your_db

# Password hashing
PASSWORD_SALT_LENGTH=10

# Session secret
SESSION_SECRET=your_session_secret

# Admin password
ADMIN_PASSWORD=your_admin_password

# Membership riddle validator (implemented as a sql query stored as env variable to keep it secret!)
# This SQL query requires 3 inputs, referenced as $1, $2 and $3, as it will be executed by PostgreSQL.
# $1 = current user id
# $2 = entered trait
# $3 = entered noun
MEMBERSHIP_RIDDLE_CHECK_VALIDITY_SQL=your_secret_sql_query

# Environment
NODE_ENV=dev

# Remember me session duration (7 days)
REMEMBER_ME_MS=604800000

# WebSocket settings
MAX_WSS_CLIENTS=100
WSS_PING_INTERVAL_MIN=30